#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include<stdint.h>
#include<signal.h>
#include<unistd.h>
void signal_handler(int signum)
{
    switch(signum){
        case SIGINT:
             printf("hello SIGINT");
             exit(signum);
             break;
        case SIGALRM:
             printf("hello\r\n");
             exit(signum);
             break;
        default:
             printf("unknown signal (%d) received",signum);
             exit(signum);
         }
}

int main()
{
signal(SIGINT,signal_handler);
signal(SIGALRM,signal_handler);//如果没有设置会触发默认的
alarm(5);
while(1){
//printf("test\r\n");
}
return 0;
}
